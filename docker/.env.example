# RotaFi local stack configuration.
#
# Copy this file to the repository root before starting the stack:
#
#   cp docker/.env.example .env
#
# Every value below has a default in docker-compose.yml, so the stack also
# runs without a .env file.

# Host ports
SOROBAN_PORT=8000
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Stellar network served by the local sandbox
NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Container image tags (pin these for reproducible environments)
QUICKSTART_TAG=testing
STELLAR_CLI_TAG=latest

# Keeper polling interval (milliseconds)
POLL_INTERVAL_MS=30000

# Local contract addresses. Leave empty for a fresh sandbox: the optional
# `contracts` profile writes them to docker/generated/deployed.env and the
# backend, keeper and frontend load that file automatically on start.
CIRCLE_FACTORY_ADDRESS=
CONTRIBUTION_VAULT_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
BID_ENGINE_ADDRESS=
