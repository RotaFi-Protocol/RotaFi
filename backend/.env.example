# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Serve read endpoints from the live RPC instead of the in-memory cache
SOROBAN_LIVE_READS=false
SOROBAN_RPC_TIMEOUT_MS=10000

# Enable the Soroban testnet integration suite (npm run test:integration)
RUN_INTEGRATION_TESTS=false

# Deployed contract addresses
CIRCLE_FACTORY_ADDRESS=CC2XL3M4FN3R2YLRGUKFWVQGWBTDQ6O4JZO66V6VGPY64QWCJBWHDSX6
CONTRIBUTION_VAULT_ADDRESS=CBIHUJSOA4GSVSLFENQRJAPFUUWHPR5DXIU6H3HEMQU4XQU5EJQHL4MO
REPUTATION_REGISTRY_ADDRESS=CDVS7X47ICQQGRR67K4FL7DAL3XB3FSSAWKXWF4RIKJVWEHTJ6AXJTUC
BID_ENGINE_ADDRESS=CD3OE7WPUSSM7ZR2552CVNZH2O5LHV52UKHSPR3VYVG63CWHUOXNDM6P

# Supported currency (Stellar asset contract) addresses, testnet defaults.
# Override to point at other deployments or custom assets. XLM here is the
# SAC token address used by the frontend node bindings; the protocol allows
# any token address to be configured on a circle.
USDC_TOKEN_ADDRESS=CBUSYNQKASUYFWYC3M2GUEDMX4AIVWPALDBYJPNK6554BREHTGZ2IUNF
EURC_TOKEN_ADDRESS=CDDCKBVUKM4ADZHCTLFT263CYRTKG2YIWLIA6XWM5IVF3GWKRNRGS5JD
XLM_TOKEN_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Server
PORT=3000
NODE_ENV=development

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
